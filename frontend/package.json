{
  "name": "seguranca-integral-aluno",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.aluno.config.ts --host 127.0.0.1",
    "test": "vitest run --config vite.aluno.config.ts && vitest run --config vite.coord.config.ts",
    "build:aluno": "tsc --noEmit && vite build --config vite.aluno.config.ts",
    "contraste": "node verificacao/contraste.mjs",
    "test:navegador": "node verificacao/navegador.mjs",
    "dev:coord": "vite --config vite.coord.config.ts --host 127.0.0.1 --open coordenacao.html",
    "build:coord": "tsc --noEmit && vite build --config vite.coord.config.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.2.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.4"
  }
}
